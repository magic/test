{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./.tmp/test-dist",
    "noEmit": true,
    "paths": {
      "@magic/test": ["./dist/index.js"],
      "@magic/test/*": ["./dist/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "docsrc/globals.d.ts"],
  "exclude": ["node_modules", "dist/**/*", "coverage", ".tmp"]
}
