{
  "name": "@magic/test",
  "version": "0.3.51",
  "description": "simple yet powerful unit testing library",
  "homepage": "https://magic.github.io/test",
  "bugs": {
    "url": "https://github.com/magic/test/issues"
  },
  "license": "AGPL-3.0",
  "author": "Wizards & Witches",
  "contributors": [
    {
      "name": "jascha ehrenreich",
      "github": "jaeh"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magic/test.git"
  },
  "bin": {
    "magic-test": "dist/bin/t.js",
    "magic-test-native": "dist/bin/node-test-runner.js",
    "t": "dist/bin/t.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#src": "./src/index.js",
    "#src/*": "./src/*",
    "#test/*": "./test/*",
    "#docsrc/*": "./docsrc/*",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./svelte": "./dist/svelte.js"
  },
  "scripts": {
    "start": "node dist/bin/t.js -p",
    "build": "tsc -p tsconfig.app.json && npm run format",
    "build:docs": "NODE_ENV=production magic build",
    "prod": "NODE_ENV=production magic build serve",
    "clean": "magic clean",
    "serve": "magic serve",
    "dev": "magic dev",
    "test": "node dist/bin/t.js -i docsrc -i src",
    "test:prepare": "tsc -p tsconfig.test.json",
    "test:native": "node --test dist/bin/node-test-runner.js --coverage && c8 report",
    "test:ci": "node dist/bin/t.js -p",
    "coverage": "node dist/bin/t.js",
    "format": "f -w --exclude docs",
    "format:check": "f --exclude docs",
    "tsc": "tsc -p tsconfig.app.json --noEmit",
    "tsc:test": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run tsc && npm run tsc:test && npm run lint",
    "lint": "oxlint"
  },
  "dependencies": {
    "@magic/cases": "0.0.14",
    "@magic/cli": "0.0.55",
    "@magic/deep": "0.1.22",
    "@magic/error": "0.0.24",
    "@magic/fs": "0.0.40",
    "@magic/log": "0.1.23",
    "@magic/types": "0.1.40",
    "@napi-rs/canvas": "1.1.0",
    "c8": "12.0.0",
    "happy-dom": "21.0.4",
    "oxc-parser": "0.157.0",
    "typescript": "npm:@typescript/typescript6"
  },
  "devDependencies": {
    "@magic-modules/git-badges": "0.0.12",
    "@magic-modules/light-switch": "0.0.12",
    "@magic-modules/no-spy": "0.0.9",
    "@magic-modules/pre": "0.0.12",
    "@magic-themes/docs": "0.0.15",
    "@magic/core": "0.0.161",
    "@magic/format": "0.0.77",
    "@magic/lint": "0.0.3",
    "@rsvelte/oxlint-plugin": "0.2.6",
    "@types/node": "26.6.6",
    "oxlint": "1.92.0",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "engineStrict": true,
  "allowScripts": {
    "@swc/core@1.15.47": true
  }
}
